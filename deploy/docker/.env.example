# Copy to .env (git-ignored) and adjust.

# Name of the billing database: lowercase letters, digits and dashes.
BILLING_DB=<your-billing-db>

# Public hostname for the optional Caddy proxy (docker compose --profile proxy up -d).
# Point its DNS A/AAAA record at this host and open ports 80 and 443.
BILLING_DOMAIN=stdb.example.com

# SpacetimeDB image tag: the module needs 2.14.1 or newer.
SPACETIMEDB_VERSION=v2.14.1

# Host port for SpacetimeDB, bound to 127.0.0.1 only.
SPACETIMEDB_PORT=3000

# Module release to download: "latest" or a tag such as v0.1.0.
BILLING_RELEASE=latest
