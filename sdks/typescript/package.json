{
  "name": "@purser/client",
  "version": "0.15.0",
  "description": "Client for a self-hosted Purser in-app purchase server: verify, restore, entitlements, paywalls, promo codes, wallet. For web games, Cocos Creator, PlayCanvas and Telegram Mini Apps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "in-app-purchase",
    "iap",
    "receipt-validation",
    "spacetimedb",
    "telegram",
    "stripe"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
